{
  "name": "@photon-ai/unicode-shield",
  "version": "0.1.0",
  "description": "Unicode normalization layer — strips invisible characters and neutralizes bidirectional text attacks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "unicode",
    "normalization",
    "invisible-characters",
    "bidi",
    "security",
    "imessage",
    "text-sanitization",
    "zero-width"
  ],
  "author": "Photon <daniel@photon.codes>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/unicode-shield.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
