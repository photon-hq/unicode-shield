# Photon Shield Server Configuration

# Redis connection string
REDIS_URL=redis://localhost:6379

# Server signing secret for challenge tokens (CHANGE IN PRODUCTION)
SHIELD_SECRET=change-me-in-production

# Public URL where challenge pages are served
# Production: https://verify.photon.codes
CHALLENGE_BASE_URL=http://localhost:3001

# How long a challenge token is valid (seconds)
CHALLENGE_TTL_SECONDS=120

# How long a verified number stays trusted (seconds, default: 7 days)
VERIFICATION_TTL_SECONDS=604800

# Server port
PORT=3001

# Enable dev mode (auto-creates dev API key, relaxed auth)
SHIELD_DEV=true

# Photon backend URL for API key validation (production only)
# When set, Shield validates Photon API keys against this endpoint.
# PHOTON_BACKEND_URL=https://api.photon.codes
